# Google Routes API (server-side only; never bundle this in website assets)
GOOGLE_MAPS_API_KEY=

# OneMap API credentials. The official token endpoint issues a token valid for 3 days.
# If you already have a current token, this is sufficient; email/password are optional.
ONEMAP_ACCESS_TOKEN=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Optional overrides
ONEMAP_BASE_URL=https://www.onemap.gov.sg
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com

# Google population/safety controls (these override the versioned defaults when set)
SUTD_EXCLUSION_RADIUS_KM=3.5
GOOGLE_SAMPLE_SIZE=1000
GOOGLE_MONTHLY_REQUEST_BUDGET=9000
GOOGLE_SAMPLING_SEED=20260910
