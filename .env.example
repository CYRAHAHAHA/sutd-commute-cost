# Google Routes API (server-side only; never bundle this in website assets)
GOOGLE_MAPS_API_KEY=

# OneMap API credentials. The official token endpoint issues a token valid for 3 days.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Optional overrides
ONEMAP_BASE_URL=https://www.onemap.gov.sg
GOOGLE_ROUTES_BASE_URL=https://routes.googleapis.com
